# Copy to api/.env for local development: cp .env.example api/.env
# Placeholders only. Real secrets go in the hosting dashboards, never in git.
# The defaults below work on a laptop. With APP_ENV=prod the API refuses to
# start until the secrets, email and proxy settings are real (config.py).
# Variables added in later milestones are listed in docs/SPEC.md section 11.3.

APP_ENV=local
DATABASE_URL=postgresql+psycopg://sewe:sewe@localhost:5432/sewe
ALLOWED_ORIGINS=http://localhost:8081

# --- Auth (M2) ---
# Production: generate each with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"            (JWT_SECRET)
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"  (DATA_ENCRYPTION_KEY)
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-0000
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Browsers on http://localhost accept Secure cookies in Chrome and Firefox.
COOKIE_SECURE=true

# --- Email (D-25) ---
# console = print emails (with their codes) to the API log. Production: resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=SEWE Finance <finance@jonathansewe.com>

# --- Passkeys ---
# Production: finance.jonathansewe.com and https://finance.jonathansewe.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8081

# --- Proxy (D-36) ---
# Peers allowed to set the client IP via X-Forwarded-For (uvicorn reads this).
# Production: the hosting proxy's address range (never 127.0.0.1, never *).
FORWARDED_ALLOW_IPS=127.0.0.1
